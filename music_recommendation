


import pandas as pd
import numpy as np

# 1. Dataset create karna (As a sample)

data = {
    'user_id': [1, 2, 3, 1, 2, 1, 3, 4],
    'song_id': ['S01', 'S02', 'S01', 'S03', 'S01', 'S02', 'S03', 'S04'],
    'listen_count': [1, 1, 1, 0, 1, 1, 0, 1], # 1 ka matlab hai repeated play[span_1](end_span)
    'timestamp': ['2023-12-01', '2023-12-05', '2023-12-10', '2023-12-12', '2023-12-15', '2023-12-20', '2023-12-25', '2023-12-30']
}

df = pd.DataFrame(data)

# 2. Recommendation Logic (Popularity Based)
def recommend_popular_songs(dataframe, n=2):
    # [span_2](start_span)Un songs ko recommend karna jo sabse zyada baar repeat huye hain[span_2](end_span)
    popular_songs = dataframe[dataframe['listen_count'] == 1]['song_id'].value_counts().head(n)
    return popular_songs.index.tolist()

# 3. Output Check
print("--- Music Recommendation System ---")
print("Top Recommended Songs for Users:")
print(recommend_popular_songs(df))

